<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="Defaults\**" />
    <Compile Remove="Defaults\**" />
    <EmbeddedResource Remove="Defaults\**" />
    <None Remove="Defaults\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Defaults\app-settings.json" />
    <Content Include="Defaults\user-commands.json" />
    <Content Include="Defaults\app-settings.json">
      <TargetPath>app-settings.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SharpHook" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaunchPad.Ignite.Core\LaunchPad.Ignite.Core.csproj" />
    <ProjectReference Include="..\LaunchPad.Ignite.Extensions.Ado\LaunchPad.Ignite.Extensions.Ado.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\LaunchPad.Ignite.Extensions.Media\LaunchPad.Ignite.Extensions.Media.csproj" ReferenceOutputAssembly="false" />
    <Content Include="..\LaunchPad.Ignite.Extensions.Ado\extension.json">
      <Link>extensions\ado\extension.json</Link>
      <TargetPath>extensions\ado\extension.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\LaunchPad.Ignite.Extensions.Media\extension.json">
      <Link>extensions\media\extension.json</Link>
      <TargetPath>extensions\media\extension.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyAdoExtensionAssemblyAfterBuild" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)extensions\ado" />
    <Copy SourceFiles="$(SolutionDir)LaunchPad.Ignite.Extensions.Ado\bin\$(Configuration)\net8.0\LaunchPad.Ignite.Extensions.Ado.dll" DestinationFiles="$(OutputPath)extensions\ado\LaunchPad.Ignite.Extensions.Ado.dll" />
  </Target>
  <Target Name="CopyMediaExtensionAssemblyAfterBuild" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)extensions\media" />
    <Copy SourceFiles="$(SolutionDir)LaunchPad.Ignite.Extensions.Media\bin\$(Configuration)\net8.0\LaunchPad.Ignite.Extensions.Media.dll" DestinationFiles="$(OutputPath)extensions\media\LaunchPad.Ignite.Extensions.Media.dll" />
  </Target>
</Project>

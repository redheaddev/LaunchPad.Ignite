<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="LaunchPad.Ignite.App.Views.SecretRevealWindow"
		Title="Secret"
		Width="480"
		SizeToContent="Height"
		CanResize="False"
		WindowStartupLocation="CenterOwner">
	<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="22" RowSpacing="16" ColumnSpacing="10">
		<TextBox x:Name="ValueBox" Grid.Row="0" IsReadOnly="True" TextWrapping="Wrap" />
		<Button Grid.Row="1" Grid.Column="0" Content="Copy" HorizontalAlignment="Left" Click="Copy_Click" />
		<Button Grid.Row="1" Grid.Column="1" Content="Close" IsDefault="True" HorizontalAlignment="Right" Click="Close_Click" />
	</Grid>
</Window>

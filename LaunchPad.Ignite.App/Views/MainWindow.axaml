<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LaunchPad.Ignite.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="360"
        x:Class="LaunchPad.Ignite.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="LaunchPad.Ignite"
        Width="760" Height="360" MinWidth="640" MinHeight="300"
        WindowDecorations="None" CanResize="False"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.header-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style Selector="Border.completion-item.highlighted">
            <Setter Property="Background" Value="#FF1E3A5F" />
        </Style>
        <Style Selector="Border.completion-item TextBlock">
            <Setter Property="Foreground" Value="#FF94A3B8" />
        </Style>
        <Style Selector="TextBlock.completion-item-text.highlighted">
            <Setter Property="Foreground" Value="#FFE2E8F0" />
        </Style>
        <Style Selector="TextBlock.completion-item-text.checked">
            <Setter Property="Foreground" Value="#FF67E8F9" />
        </Style>
    </Window.Styles>

    <Border Background="#F2111827"
            BorderBrush="#FF334155"
            BorderThickness="1"
            CornerRadius="18"
            Padding="22">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8"
                            PointerPressed="HeaderBar_PointerPressed">
                    <TextBlock Text="🚀" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="LaunchPad" FontSize="15" FontWeight="SemiBold"
                               Foreground="#FF67E8F9" VerticalAlignment="Center" />
                    <TextBlock Text="command launcher" FontSize="15"
                               Foreground="#FF94A3B8" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Classes="header-action" Content="?" ToolTip.Tip="Help" />
                    <Button Classes="header-action" Content="⇅" ToolTip.Tip="Import / Export" />
                    <Button Classes="header-action" Content="⚙" ToolTip.Tip="Settings" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#FF020617" BorderBrush="#FF334155"
                    BorderThickness="1" CornerRadius="10" Padding="12,8">
                <Grid ClipToBounds="True" ColumnDefinitions="12,*">
                    <TextBox x:Name="CommandBox" Grid.ColumnSpan="2" Text="{Binding CommandText}"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="22" Foreground="Transparent"
                             Background="Transparent" BorderThickness="0" Padding="12,0,0,0"
                             VerticalContentAlignment="Center"
                             CaretBrush="#FF67E8F9" />
                    <TextBlock Grid.Column="1" Text="Enter a command" IsVisible="{Binding IsCommandTextEmpty}"
                               IsHitTestVisible="False" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas" FontSize="22"
                               Foreground="#FF64748B" />
                    <TextBlock Grid.Column="1" IsHitTestVisible="False" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas" FontSize="22"
                               TextWrapping="NoWrap">
                        <TextBlock.Inlines><Run Text="{Binding CommandText}" Foreground="#FFE2E8F0"/><Run Text="{Binding CompletionGhostText}" Foreground="#FF64748B"/></TextBlock.Inlines>
                    </TextBlock>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="3,12,3,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Text="{Binding UsageText}"
                               IsVisible="{Binding HasUsageText}"
                               Foreground="#FF64748B" FontFamily="Cascadia Mono, Consolas"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"
                               Margin="0,0,0,8" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding HasCommandExpansionPreview}" Margin="0,0,0,8">
                        <TextBlock Text="Expanded:" Foreground="#FF64748B" FontSize="12" />
                        <TextBlock Text="{Binding CommandExpansionPreview}" Foreground="#FF67E8F9"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding HasCompletionOptions}">
                        <ItemsControl x:Name="CompletionList" ItemsSource="{Binding CompletionItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="completion-item" Padding="4,1" CornerRadius="4"
                                            Classes.highlighted="{Binding IsHighlighted}">
                                        <TextBlock Classes="completion-item-text"
                                                   Classes.highlighted="{Binding IsHighlighted}"
                                                   Classes.checked="{Binding IsSelected}"
                                                   Text="{Binding DisplayText}"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="13" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                               Foreground="#FF64748B" FontSize="12"
                               VerticalAlignment="Bottom" />
                </Grid>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16" Margin="3,12,3,0">
                <TextBlock Text="Alt/Option+Space  toggle" Foreground="#FF64748B" FontSize="11" />
                <TextBlock Text="Enter  run" Foreground="#FF64748B" FontSize="11" />
                <TextBlock Text="Tab  complete" Foreground="#FF64748B" FontSize="11" />
                <TextBlock Text="Esc  close" Foreground="#FF64748B" FontSize="11" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

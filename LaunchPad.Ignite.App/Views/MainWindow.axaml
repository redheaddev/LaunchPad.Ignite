<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LaunchPad.Ignite.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="360"
        x:Class="LaunchPad.Ignite.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/rocket.ico"
        Title="LaunchPad.Ignite"
        Width="760" Height="360" MinWidth="640" MinHeight="300"
        WindowDecorations="None" CanResize="False"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.header-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style Selector="Border.main-panel">
            <Setter Property="Padding" Value="22" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style Selector="Border.mini-panel">
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.command-input">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.command-input.mini">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.mini-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.completion-item.highlighted">
            <Setter Property="Background" Value="{DynamicResource ThemeHighlight}" />
        </Style>
        <Style Selector="Border.completion-item TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryText}" />
        </Style>
        <Style Selector="TextBlock.completion-item-text.highlighted">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
        </Style>
        <Style Selector="TextBlock.completion-item-text.checked">
            <Setter Property="Foreground" Value="{DynamicResource ThemeChecked}" />
        </Style>
        <Style Selector="Border.command-input.focused">
            <Setter Value="{DynamicResource ThemeCommandFocus}" Property="BorderBrush" />
        </Style>
        <Style Selector="TextBox#CommandBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCommandFocus}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource ThemePanelBackground}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1"
            Classes.main-panel="{Binding IsMainMode}"
            Classes.mini-panel="{Binding IsMiniMode}">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid Grid.Row="0" Margin="0,0,0,12" IsVisible="{Binding IsMainMode}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Image Source="/Assets/rocket.png" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="LaunchPad" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" />
                    <TextBlock Text="command launcher" FontSize="15"
                               Foreground="{DynamicResource ThemeSecondaryText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppVersion}" FontSize="11"
                               Foreground="{DynamicResource ThemeMutedText}" VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding SecretLockIcon}"
                               Foreground="{Binding SecretLockBrush}"
                               ToolTip.Tip="{Binding SecretLockTooltip}"
                               FontSize="16" VerticalAlignment="Center" Margin="4,0,8,0" />
                    <Button Classes="header-action" Content="?" ToolTip.Tip="Help" Click="HelpButton_Click" />
                    <Button Classes="header-action" Content="⇅" ToolTip.Tip="Import / Export"
                            Click="ImportExportButton_Click" />
                    <Button Classes="header-action" Content="⚙" ToolTip.Tip="Settings"
                            Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>

            <Border x:Name="CommandInputBorder" Grid.Row="1" Classes="command-input" Classes.mini="{Binding IsMiniMode}" Background="{DynamicResource ThemeInputBackground}" BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1">
                <Grid ClipToBounds="True" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Spacing="2" IsVisible="{Binding IsMiniMode}">
                        <Image Source="/Assets/rocket.png" Width="18" Height="18" Stretch="Uniform"
                               VerticalAlignment="Center" Margin="2" />
                        <Button Classes="mini-action" Content="{Binding SecretLockIcon}"
                                Foreground="{Binding SecretLockBrush}"
                                ToolTip.Tip="{Binding SecretLockTooltip}"
                                Click="SecretLockButton_Click" />
                        <Button Classes="mini-action" Content="?" ToolTip.Tip="Help"
                                Click="HelpButton_Click" />
                        <Button Classes="mini-action" Content="⇅" ToolTip.Tip="Import / Export"
                                Click="ImportExportButton_Click" />
                        <Button Classes="mini-action" Content="⚙" ToolTip.Tip="Settings"
                                Click="SettingsButton_Click" />
                    </StackPanel>
                    <TextBox x:Name="CommandBox" Grid.Column="1" Text="{Binding CommandInputText}"
                             FontFamily="Cascadia Mono, Consolas"
                              FontSize="22" Foreground="{DynamicResource ThemeText}"
                             Background="{DynamicResource ThemeInputBackground}" BorderThickness="0" Padding="12,0,0,0"
                             FocusAdorner="{x:Null}"
                             GotFocus="CommandBox_GotFocus" LostFocus="CommandBox_LostFocus"
                             SelectionBrush="{DynamicResource ThemeTextSelection}"
                             SelectionForegroundBrush="{DynamicResource ThemeTextSelectionForeground}"
                             TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource ThemeAccent}" />
                    <TextBlock Grid.Column="1" Text="Enter a command" IsVisible="{Binding ShowCommandPlaceholder}"
                                IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                               FontFamily="Cascadia Mono, Consolas" FontSize="22"
                                Foreground="{DynamicResource ThemeMutedText}" />
                    <TextBlock x:Name="CommandTextOverlay" Grid.Column="1" IsHitTestVisible="False" VerticalAlignment="Center"
                                Margin="12,0,0,0"
                               FontFamily="Cascadia Mono, Consolas" FontSize="22"
                               TextWrapping="NoWrap" ClipToBounds="True">
                        <TextBlock.Inlines><Run Text="{Binding CommandInputText}" Foreground="Transparent"/><Run Text="{Binding CompletionGhostText}" Foreground="{DynamicResource ThemeMutedText}"/></TextBlock.Inlines>
                    </TextBlock>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="3,12,3,0" IsVisible="{Binding IsMainMode}">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <TextBlock x:Name="UsageTextBlock"
                                 Foreground="{DynamicResource ThemeSecondaryText}" FontFamily="Cascadia Mono, Consolas"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"
                               Margin="0,0,0,8" />
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="6"
                          Margin="0,0,0,8">
                        <TextBlock Text="Target:" Foreground="{DynamicResource ThemeMutedText}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding TargetPreviewDisplay}" ToolTip.Tip="{Binding TargetPreviewDisplay}"
                                   Foreground="{DynamicResource ThemeTarget}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding HasCommandExpansionPreview}" Margin="0,0,0,8">
                        <TextBlock Text="Expanded:" Foreground="{DynamicResource ThemeMutedText}" FontSize="12" />
                        <TextBlock Text="{Binding CommandExpansionPreview}" Foreground="{DynamicResource ThemeAccent}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding HasCompletionOptions}">
                        <ItemsControl x:Name="CompletionList" ItemsSource="{Binding CompletionItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="completion-item" Padding="4,1" CornerRadius="4"
                                            Classes.highlighted="{Binding IsHighlighted}">
                                        <TextBlock Classes="completion-item-text"
                                                   Classes.highlighted="{Binding IsHighlighted}"
                                                   Classes.checked="{Binding IsSelected}"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="13">
                                            <TextBlock.Inlines>
                                                <Run Text="{Binding DisplayText}" />
                                                <Run Text="{Binding KindText}" Foreground="{DynamicResource ThemeMutedText}" />
                                                <Run Text="{Binding CyanText}" Foreground="{DynamicResource ThemeAccent}" />
                                            </TextBlock.Inlines>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="4" Spacing="6">
                        <Border Height="1" Background="{DynamicResource ThemeBorder}" />
                        <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,*" ColumnSpacing="6"
                              IsVisible="{Binding IsValueOutput}">
                            <TextBlock Text="Result:" Foreground="{DynamicResource ThemeAccent}" FontSize="14"
                                       VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                                       Foreground="{Binding StatusMessageBrush}" FontSize="14"
                                       TextWrapping="Wrap" VerticalAlignment="Top" />
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}"
                                   IsVisible="{Binding IsStatusMessage}"
                                   Foreground="{Binding StatusMessageBrush}" FontSize="14"
                                   TextWrapping="Wrap" VerticalAlignment="Bottom" />
                    </StackPanel>
                </Grid>
            </Grid>

            <TextBlock Grid.Row="2" Text="{Binding MiniUsageStatusText}"
                       IsVisible="{Binding IsMiniMode}" Margin="4,4,4,0"
                       Foreground="{DynamicResource ThemeSecondaryText}"
                       FontFamily="Cascadia Mono, Consolas" FontSize="12"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16" Margin="3,12,3,0"
                        IsVisible="{Binding IsMainMode}">
                <TextBlock Text="Enter/Ctrl+Shift/Alt -> launch/elevated/other user" Foreground="{DynamicResource ThemeMutedText}" FontSize="11" />
				<TextBlock Text="Shift+Enter -> url: launch in new window" Foreground="{DynamicResource ThemeMutedText}" FontSize="11" />
				<TextBlock Text="Tab/Right-Arrow -> accept" Foreground="{DynamicResource ThemeMutedText}" FontSize="11" />
				<TextBlock Text="Esc -> close" Foreground="{DynamicResource ThemeMutedText}" FontSize="11" />
            </StackPanel>

        </Grid>
    </Border>
</Window>

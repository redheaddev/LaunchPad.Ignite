<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:LaunchPad.Ignite.App.ViewModels"
		x:Class="LaunchPad.Ignite.App.Views.SettingsWindow"
		x:DataType="vm:SettingsViewModel"
		Title="LaunchPad Settings"
		Width="900" Height="620" MinWidth="760" MinHeight="500"
		WindowStartupLocation="CenterOwner"
		Background="#FF0F172A">
	<Grid ColumnDefinitions="240,*">
		<Border Grid.Column="0" Background="#FF111827" BorderBrush="#FF334155" BorderThickness="0,0,1,0" Padding="18">
			<DockPanel>
				<TextBlock DockPanel.Dock="Top" Text="SETTINGS" Foreground="#FF64748B" FontSize="11" FontWeight="Bold" Margin="8,4,0,14" />
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Name}" Padding="10,8" Foreground="#FFE2E8F0" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</ScrollViewer>
			</DockPanel>
		</Border>
		<Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="30,26">
			<StackPanel Spacing="5" Margin="0,0,0,22">
				<TextBlock Text="{Binding Header}" FontSize="25" FontWeight="SemiBold" Foreground="#FFE2E8F0" />
				<TextBlock Text="{Binding Subheader}" FontSize="13" Foreground="#FF94A3B8" />
				<CheckBox Content="Extension enabled" IsVisible="{Binding IsExtensionSelected}"
						  IsChecked="{Binding IsExtensionEnabled}" Click="ExtensionEnabled_Click"
						  Foreground="#FFE2E8F0" Margin="0,10,0,0" />
			</StackPanel>
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
				<ItemsControl ItemsSource="{Binding Settings}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Background="#FF111C2E" BorderBrush="#FF26364D" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
								<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
									<TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" Foreground="#FFE2E8F0" />
									<TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="#FF94A3B8" Margin="0,5,0,10" />
									<ComboBox Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding Options}"
										  SelectedItem="{Binding Value, Mode=TwoWay}" IsVisible="{Binding IsSelect}" />
									<TextBox Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Value, Mode=TwoWay}" Watermark="{Binding Label}"
									 IsVisible="{Binding IsNotSelect}" />
									<TextBlock Grid.Row="3" Text="{Binding Token}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#FF67E8F9" Margin="0,8,0,0" />
									<Button Grid.Row="3" Grid.Column="1" Content="Save" Command="{Binding SaveSettingCommand}" Margin="10,5,0,0" />
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</Grid>
</Window>

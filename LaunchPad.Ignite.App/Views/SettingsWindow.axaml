<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:LaunchPad.Ignite.App.ViewModels"
		x:Class="LaunchPad.Ignite.App.Views.SettingsWindow"
		x:DataType="vm:SettingsViewModel"
		Title="LaunchPad Settings"
		Width="1080" Height="744" MinWidth="912" MinHeight="600"
		WindowStartupLocation="CenterOwner"
		Background="{DynamicResource ThemeWindowBackground}">
	<Grid ColumnDefinitions="240,*">
		<Border Grid.Column="0" Background="{DynamicResource ThemeWindowBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="18">
			<DockPanel>
				<TextBlock DockPanel.Dock="Top" Text="SETTINGS" Foreground="{DynamicResource ThemeMutedText}" FontSize="11" FontWeight="Bold" Margin="8,4,0,14" />
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}" Background="Transparent">
						<ListBox.Styles>
							<Style Selector="ListBoxItem /template/ ContentPresenter">
								<Setter Property="Background" Value="Transparent" />
							</Style>
							<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
								<Setter Property="Background" Value="{DynamicResource ThemeHighlight}" />
							</Style>
							<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
								<Setter Property="Background" Value="{DynamicResource ThemeNavigationSelected}" />
							</Style>
						</ListBox.Styles>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Name}" Padding="{Binding Indent, FallbackValue=0},8,10,8" Foreground="{DynamicResource ThemeText}" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</ScrollViewer>
			</DockPanel>
		</Border>
		<Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="30,26">
			<StackPanel Spacing="5" Margin="0,0,0,22">
				<TextBlock Text="{Binding Header}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
				<TextBlock Text="{Binding Subheader}" FontSize="13" Foreground="{DynamicResource ThemeSecondaryText}" />
				<CheckBox Content="Extension enabled" IsVisible="{Binding IsExtensionSelected}"
						  IsChecked="{Binding IsExtensionEnabled}" Click="ExtensionEnabled_Click"
						  Foreground="{DynamicResource ThemeText}" Margin="0,10,0,0" />
			</StackPanel>
			<Grid Grid.Row="1" IsVisible="{Binding IsThemeSelected}" RowDefinitions="Auto,*">
			<StackPanel Spacing="14" Margin="0,0,0,12">
				<TextBlock Text="Color theme" Foreground="{DynamicResource ThemeText}" FontSize="16" FontWeight="SemiBold" />
				<ComboBox ItemsSource="{Binding ColorThemes}" SelectedItem="{Binding SelectedColorTheme, Mode=OneWay}"
						  SelectionChanged="ColorTheme_SelectionChanged">
					<ComboBox.Styles>
						<Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource ThemeHighlight}" />
						</Style>
						<Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource ThemeHighlight}" />
						</Style>
					</ComboBox.Styles>
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				<Button Content="Delete theme" Click="DeleteTheme_Click"
						IsEnabled="{Binding CanDeleteSelectedColorTheme}" HorizontalAlignment="Left" />
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<TextBox Text="{Binding RenameThemeName}" Watermark="Theme name" />
					<Button Grid.Column="1" Content="Rename theme" Click="RenameTheme_Click"
							IsEnabled="{Binding CanRenameSelectedColorTheme}" />
				</Grid>
				<TextBlock Text="The selected palette is applied immediately and saved to your profile."
							  Foreground="{DynamicResource ThemeSecondaryText}" TextWrapping="Wrap" />
				<Button Content="Open theme reference" Click="OpenThemeReference_Click"
						IsVisible="{Binding HasSelectedColorThemeUrl}" HorizontalAlignment="Left" />
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<TextBox Text="{Binding ThemeReferenceUrl}" Watermark="Theme reference URL (HTTPS)" />
					<Button Grid.Column="1" Content="Save reference" Click="SaveThemeReference_Click"
							IsEnabled="{Binding HasUnsavedThemeReferenceUrlChanges}" />
				</Grid>
				<TextBlock Text="Colors below show where each choice appears in the launcher and Settings." Foreground="{DynamicResource ThemeSecondaryText}" TextWrapping="Wrap" />
				<Button Content="Save changes" Click="SaveThemeColors_Click"
						IsEnabled="{Binding HasUnsavedThemeColorChanges}" HorizontalAlignment="Left" />
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<TextBox Text="{Binding ThemeImportUrl}" Watermark="Paste a palette page URL" />
					<Button Grid.Column="1" Content="Import palette" Click="ImportTheme_Click" />
				</Grid>
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<TextBox Text="{Binding NewThemeName}" Watermark="New theme name" />
					<Button Grid.Column="1" Content="Create theme" Click="CreateTheme_Click" />
				</Grid>
				<TextBlock Text="{Binding ThemeImportStatus}" Foreground="{DynamicResource ThemeSecondaryText}" TextWrapping="Wrap" />
			</StackPanel>
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<ItemsControl ItemsSource="{Binding ThemeColors}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
									<Grid ColumnDefinitions="34,150,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
										<Border Width="30" Height="30" CornerRadius="5" Background="{Binding PickerBrush}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" VerticalAlignment="Center" />
										<TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" />
										<TextBox Grid.Column="2" Text="{Binding Value}" Watermark="#AARRGGBB" VerticalAlignment="Center" LostFocus="ThemeColorHex_LostFocus" Tag="{Binding Property}" />
										<ColorPicker Grid.Column="3" Color="{Binding PickerColor, Mode=TwoWay}" />
										<TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Usage}" Foreground="{DynamicResource ThemeMutedText}" FontSize="11" TextWrapping="Wrap" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsExtensionsSelected}">
				<TextBlock Text="Select an extension from the navigation list to manage its settings, secrets, and enabled status." TextWrapping="Wrap" Foreground="{DynamicResource ThemeSecondaryText}" />
			</ScrollViewer>
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsPacksSelected}">
				<StackPanel Spacing="8">
					<ItemsControl ItemsSource="{Binding CommandPackGroups}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:CommandPackGroupSettingsViewModel">
								<Border Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
									<StackPanel Spacing="8">
										<Grid ColumnDefinitions="*,Auto">
											<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
												<TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeText}" FontWeight="SemiBold" />
												<TextBlock Text="{Binding Details}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="12" VerticalAlignment="Center" />
											</StackPanel>
											<CheckBox Grid.Column="1" Content="Group enabled" IsThreeState="True" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" Margin="12,0,0,0" />
										</Grid>
										<ItemsControl ItemsSource="{Binding Packs}">
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="vm:CommandPackSettingsViewModel">
													<Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
														<Grid ColumnDefinitions="*,Auto">
															<Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
																<Expander.Header>
																	<StackPanel Orientation="Horizontal" Spacing="10">
																		<TextBlock Text="{Binding Id}" Foreground="{DynamicResource ThemeText}" FontWeight="SemiBold" />
																		<TextBlock Text="{Binding Details}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="12" VerticalAlignment="Center" />
																	</StackPanel>
																</Expander.Header>
																<ItemsControl ItemsSource="{Binding Commands}" Margin="8,8,0,0">
																	<ItemsControl.ItemTemplate>
																		<DataTemplate>
																			<TextBlock Text="{Binding}" Foreground="{DynamicResource ThemeText}" Margin="0,2" />
																		</DataTemplate>
																	</ItemsControl.ItemTemplate>
																</ItemsControl>
															</Expander>
														<CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" Margin="12,0,0,0" />
													</Grid>
													</Border>
												</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<ItemsControl ItemsSource="{Binding UngroupedCommandPacks}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:CommandPackSettingsViewModel">
								<Border Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
									<Grid ColumnDefinitions="*,Auto">
										<Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
										<Expander.Header>
											<StackPanel Orientation="Horizontal" Spacing="10">
												<TextBlock Text="{Binding Id}" Foreground="{DynamicResource ThemeText}" FontWeight="SemiBold" />
												<TextBlock Text="{Binding Details}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="12" VerticalAlignment="Center" />
											</StackPanel>
										</Expander.Header>
										<ItemsControl ItemsSource="{Binding Commands}" Margin="8,8,0,0">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<TextBlock Text="{Binding}" Foreground="{DynamicResource ThemeText}" Margin="0,2" />
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Expander>
									<CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" Margin="12,0,0,0" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</ScrollViewer>
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsExtensionSelected}">
				<StackPanel Spacing="12">
					<Border IsVisible="{Binding IsMediaExtensionSelected}" Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
						<StackPanel Spacing="10">
							<TextBlock Text="Media keyboard shortcuts" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
							<TextBlock Text="Change a chord, then save it. Leave the chord empty and save to restore the extension default." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
							<ItemsControl ItemsSource="{Binding MediaShortcutEditors}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:MediaShortcutEditorViewModel">
										<Grid ColumnDefinitions="120,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4" Margin="0,4">
											<TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource ThemeText}" />
											<TextBox Grid.Column="1" Text="{Binding Shortcut}" Watermark="alt+num+8" />
											<Button Grid.Column="2" Content="Capture" Click="CaptureMediaShortcut_Click" Tag="{Binding}" />
											<Button Grid.Column="3" Content="Save" Command="{Binding SaveShortcutCommand}" />
											<TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource ThemeSecondaryText}" />
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
					<ItemsControl ItemsSource="{Binding Settings}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
									<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
										<TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
										<TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" Margin="0,5,0,10" />
										<ComboBox Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay}" IsVisible="{Binding IsSelect}" />
										<TextBox Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Value, Mode=TwoWay}" Watermark="{Binding Label}" IsVisible="{Binding IsNotSelect}" />
										<TextBlock Grid.Row="3" Text="{Binding Token}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource ThemeAccent}" Margin="0,8,0,0" />
										<Button Grid.Row="3" Grid.Column="1" Content="Save" Command="{Binding SaveSettingCommand}" Margin="10,5,0,0" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<StackPanel Spacing="8" IsVisible="{Binding IsExtensionSelected}">
						<TextBlock Text="Extension list defaults" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
						<TextBlock Text="Choose a default for each list. Select 'Use extension default' to remove your override." TextWrapping="Wrap" Foreground="{DynamicResource ThemeSecondaryText}" />
						<ItemsControl ItemsSource="{Binding ListDefaultEditors}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:ListDefaultEditorViewModel">
									<Border Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
										<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
											<TextBlock Text="{Binding ListName}" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" />
											<ComboBox Grid.Column="1" ItemsSource="{Binding Values}" SelectedItem="{Binding SelectedDefault, Mode=TwoWay}" MinWidth="180" />
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
					<TextBlock Text="No extension enum lists are available." IsVisible="{Binding HasNoLists}" Foreground="{DynamicResource ThemeSecondaryText}" />
					<Border Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16" IsVisible="{Binding HasSelectedExtensionSecretPermissions}">
						<StackPanel Spacing="8">
							<TextBlock Text="Allowed secrets" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
							<TextBlock Text="Secret access is denied unless explicitly allowed for this extension." FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
							<ItemsControl ItemsSource="{Binding SelectedExtensionSecretPermissions.Secrets}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:SecretPermissionChoiceViewModel">
										<StackPanel Orientation="Horizontal" Spacing="8">
											<CheckBox IsChecked="{Binding IsAllowed, Mode=TwoWay}" Foreground="{DynamicResource ThemeText}" />
											<TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" />
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsCommandsSelected}">
				<StackPanel Spacing="12">
					<ComboBox ItemsSource="{Binding CommandSourceFilters}" SelectedItem="{Binding SelectedCommandSourceFilter, Mode=TwoWay}" />
					<ComboBox ItemsSource="{Binding FilteredCommandDetails}" SelectedItem="{Binding SelectedCommandDetails, Mode=TwoWay}">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="vm:CommandDetailsViewModel">
								<TextBlock Text="{Binding QualifiedName}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<ContentControl Content="{Binding SelectedCommandDetails}">
						<ContentControl.ContentTemplate>
							<DataTemplate x:DataType="vm:CommandDetailsViewModel">
								<ScrollViewer VerticalScrollBarVisibility="Auto">
									<StackPanel Spacing="10">
										<Border Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
											<StackPanel Spacing="8">
												<TextBlock Text="Command details" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
												<Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
													<TextBlock Text="Name" Foreground="{DynamicResource ThemeSecondaryText}" />
													<TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
													<TextBlock Grid.Row="1" Text="Namespace" Foreground="{DynamicResource ThemeSecondaryText}" />
													<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Namespace, Mode=TwoWay}" Watermark="(global)" IsEnabled="{Binding IsEditable}" />
													<TextBlock Grid.Row="2" Text="Qualified name" Foreground="{DynamicResource ThemeSecondaryText}" />
													<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding QualifiedName}" Foreground="{DynamicResource ThemeText}" />
													<TextBlock Grid.Row="3" Text="Kind" Foreground="{DynamicResource ThemeSecondaryText}" />
													<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Kind}" Foreground="{DynamicResource ThemeText}" />
													<TextBlock Grid.Row="4" Text="Description" Foreground="{DynamicResource ThemeSecondaryText}" />
													<TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Description, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" TextWrapping="Wrap" />
													<TextBlock Grid.Row="5" Text="Source" Foreground="{DynamicResource ThemeSecondaryText}" />
													<TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SourceLocation}" Foreground="{DynamicResource ThemeText}" />
													<TextBlock Grid.Row="6" Text="Keyboard shortcut" Foreground="{DynamicResource ThemeSecondaryText}" />
													<Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,Auto">
														<TextBox Text="{Binding KeyboardShortcut, Mode=TwoWay}" Watermark="ctrl+alt+p" IsEnabled="{Binding IsEditable}" />
														<Button Grid.Column="1" Content="Assign key" Tag="{Binding}" Click="CaptureCommandShortcut_Click" IsEnabled="{Binding IsEditable}" Margin="6,0,0,0" />
													</Grid>
													<CheckBox Grid.Row="7" Grid.Column="1" Content="Execute immediately on shortcut" IsChecked="{Binding ExecuteOnKeyboardShortcut, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
												</Grid>
												<TextBlock Text="{Binding ShortcutStatus}" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
												<Grid ColumnDefinitions="*,Auto">
													<StackPanel Spacing="3">
														<TextBlock Text="Actions" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
														<TextBlock Text="Choose an action to edit its usage, target, argument templates and inputs." FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
													</StackPanel>
													<Button Grid.Column="1" Content="Add action" Command="{Binding AddNewActionCommand}" IsVisible="{Binding IsEditable}" />
												</Grid>
												<ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction, Mode=TwoWay}" IsEnabled="{Binding IsEditable}">
													<ComboBox.ItemTemplate>
														<DataTemplate x:DataType="vm:CommandActionEditorViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate>
													</ComboBox.ItemTemplate>
												</ComboBox>
												<ContentControl Content="{Binding SelectedAction}">
													<ContentControl.ContentTemplate>
														<DataTemplate x:DataType="vm:CommandActionEditorViewModel">
															<StackPanel Spacing="8">
																<Grid ColumnDefinitions="*,Auto">
																	<TextBlock Text="Action details" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
																	<Button Grid.Column="1" Content="Remove action" Command="{Binding RemoveSelectedActionCommand}" IsVisible="{Binding CanRemove}" />
																</Grid>
																<TextBlock Text="Action name" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
												<TextBox Text="{Binding Name, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
												<TextBlock Text="Keyboard shortcut" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
												<Grid ColumnDefinitions="*,Auto">
													<TextBox Text="{Binding KeyboardShortcut, Mode=TwoWay}" Watermark="ctrl+alt+p" IsEnabled="{Binding IsEditable}" />
													<Button Grid.Column="1" Content="Assign key" Tag="{Binding}" Click="CaptureCommandActionShortcut_Click" IsEnabled="{Binding IsEditable}" Margin="6,0,0,0" />
												</Grid>
												<CheckBox Content="Execute immediately on shortcut" IsChecked="{Binding ExecuteOnKeyboardShortcut, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
												<TextBlock Text="{Binding ShortcutStatus}" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
																<TextBlock Text="Description" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
												<TextBox Text="{Binding Description, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
																<TextBlock Text="Usage - syntax shown to users; brackets usually mark optional arguments." FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
												<TextBox Text="{Binding Usage, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
																<TextBlock Text="Target template - program, URL, or path opened by this action." FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
												<TextBox Text="{Binding TargetTemplate, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
																<TextBlock Text="Working directory - optional directory to use when starting a shell command." FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
												<TextBox Text="{Binding WorkingDirectoryTemplate, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
																<TextBlock Text="Argument templates - one target argument per line; {name} inserts the supplied value." FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
												<TextBox Text="{Binding ArgumentTemplates, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" AcceptsReturn="True" MinHeight="60" />
																<Grid ColumnDefinitions="*,Auto">
																	<TextBlock Text="Arguments (in positional order)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
																	<Button Grid.Column="1" Content="Add argument" Command="{Binding AddArgumentCommand}" IsVisible="{Binding IsEditable}" />
																</Grid>
																<ItemsControl ItemsSource="{Binding Arguments}">
																	<ItemsControl.ItemTemplate>
																		<DataTemplate x:DataType="vm:CommandArgumentEditorViewModel">
																			<Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
																				<StackPanel Spacing="6">
																			<Grid ColumnDefinitions="*,Auto,Auto,Auto">
												<TextBox Text="{Binding Name, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" Watermark="Argument name" />
																				<Button Grid.Column="1" Content="Move up" Command="{Binding MoveEarlierCommand}" IsEnabled="{Binding CanMoveEarlier}" IsVisible="{Binding IsEditable}" Margin="6,0,0,0" />
																				<Button Grid.Column="2" Content="Move down" Command="{Binding MoveLaterCommand}" IsEnabled="{Binding CanMoveLater}" IsVisible="{Binding IsEditable}" Margin="6,0,0,0" />
																				<Button Grid.Column="3" Content="Remove" Command="{Binding $parent[ItemsControl].DataContext.RemoveArgumentCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsEditable}" Margin="6,0,0,0" />
																					</Grid>
																					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
																						<CheckBox Content="Optional (not required)" IsChecked="{Binding IsOptional, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
																						<StackPanel Grid.Column="1" Spacing="3">
																							<TextBlock Text="Input format" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
																							<ComboBox ItemsSource="{Binding InputTypes}" SelectedItem="{Binding InputType, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
																						</StackPanel>
																						<StackPanel Grid.Row="1" Spacing="3">
																							<TextBlock Text="Value source (enum/list or free text)" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
																					<ComboBox ItemsSource="{Binding ReferenceChoices}" SelectedItem="{Binding SelectedReference, Mode=TwoWay}" IsEnabled="{Binding IsEditable}">
																						<ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CommandListReferenceChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
																							</ComboBox>
											<TextBox Text="{Binding ListReference, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" Watermark="Runtime list reference: list:dynamicName" />
																						</StackPanel>
																						<StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
																							<CheckBox Content="Allow values outside the list" IsChecked="{Binding AllowCustomValues, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
																							<CheckBox Content="Single selection (list references only)" IsChecked="{Binding IsSingleSelection, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" IsVisible="{Binding IsListReference}" />
																							<CheckBox Content="Sensitive value" IsChecked="{Binding IsSensitive, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
																						</StackPanel>
																					</Grid>
																				</StackPanel>
																			</Border>
																		</DataTemplate>
																</ItemsControl.ItemTemplate>
															</ItemsControl>
														</StackPanel>
													</DataTemplate>
												</ContentControl.ContentTemplate>
											</ContentControl>
												<Button Content="Save changes" Command="{Binding SaveCommand}" IsVisible="{Binding IsEditable}" IsEnabled="{Binding HasUnsavedChanges}" HorizontalAlignment="Left" />
												<StackPanel IsVisible="{Binding IsShellCommand}" Spacing="6">
													<TextBlock Text="Launch behavior when Enter is pressed" Foreground="{DynamicResource ThemeText}" />
												<ComboBox ItemsSource="{Binding LaunchModes}" SelectedItem="{Binding SelectedLaunchMode, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" />
												</StackPanel>
										</StackPanel>
									</Border>
								</StackPanel>
							</ScrollViewer>
							</DataTemplate>
						</ContentControl.ContentTemplate>
					</ContentControl>
				</StackPanel>
			</ScrollViewer>
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsListsSelected}">
				<StackPanel Spacing="12">
					<ComboBox ItemsSource="{Binding EnumListEditors}" SelectedItem="{Binding SelectedEnumListEditor, Mode=TwoWay}">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="vm:EnumListEditorViewModel">
								<TextBlock Text="{Binding ListName}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<ContentControl Content="{Binding SelectedEnumListEditor}">
						<ContentControl.ContentTemplate>
							<DataTemplate x:DataType="vm:EnumListEditorViewModel">
								<Border Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
									<StackPanel Spacing="10">
										<TextBlock Text="Enum list" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
										<TextBlock Text="Enter one option per line. Saving puts the selected default first and sorts the remaining values alphabetically." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
										<TextBlock Text="Values" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
										<TextBox Text="{Binding ValuesText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="150" TextWrapping="Wrap" />
										<TextBlock Text="Default value" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
										<ComboBox ItemsSource="{Binding Values}" SelectedItem="{Binding SelectedDefault, Mode=TwoWay}" />
										<StackPanel Orientation="Horizontal" Spacing="10">
											<Button Content="Save list" Command="{Binding SaveCommand}" />
							<Button Content="Reset to defaults" Command="{Binding ResetCommand}" />
											<TextBlock Text="{Binding Status}" Foreground="{DynamicResource ThemeSecondaryText}" VerticalAlignment="Center" />
										</StackPanel>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ContentControl.ContentTemplate>
					</ContentControl>
					<TextBlock Text="No enum lists are available." IsVisible="{Binding HasNoEnumLists}" Foreground="{DynamicResource ThemeSecondaryText}" />
				</StackPanel>
			</ScrollViewer>
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsMetadataSelected}">
				<StackPanel Spacing="14">
					<Border Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
						<StackPanel Spacing="10">
							<TextBlock Text="Object metadata schema" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
							<ComboBox ItemsSource="{Binding MetadataObjectTypes}" SelectedItem="{Binding SelectedMetadataObjectType, Mode=TwoWay}" />
							<TextBlock Text="Metadata is stored in your profile and is not secret. Do not enter passwords, tokens, or other sensitive values." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
							<ListBox ItemsSource="{Binding MetadataEditor.Fields}" SelectedItem="{Binding MetadataEditor.SelectedField, Mode=TwoWay}" MinHeight="90">
								<ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeText}" /></DataTemplate></ListBox.ItemTemplate>
							</ListBox>
							<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
								<TextBox Text="{Binding MetadataEditor.FieldName, Mode=TwoWay}" Watermark="Field name" />
								<ComboBox Grid.Column="1" ItemsSource="{Binding MetadataEditor.FieldTypes}" SelectedItem="{Binding MetadataEditor.SelectedFieldType, Mode=TwoWay}" />
							</Grid>
							<TextBox Text="{Binding MetadataEditor.ChoicesText, Mode=TwoWay}" Watermark="Choices, one per line" AcceptsReturn="True" MinHeight="70" IsVisible="{Binding MetadataEditor.IsChoicesType}" />
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Content="Add field" Click="AddMetadataField_Click" />
								<Button Content="Save field" Click="SaveMetadataField_Click" />
								<Button Content="Delete field" Click="DeleteMetadataField_Click" />
								<TextBlock Text="{Binding MetadataEditor.Status}" Foreground="{DynamicResource ThemeSecondaryText}" VerticalAlignment="Center" />
							</StackPanel>
						</StackPanel>
					</Border>
					<Border Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16" IsVisible="{Binding MetadataEditor.HasTargets}">
						<StackPanel Spacing="10">
							<TextBlock Text="Object metadata values" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
							<TextBlock Text="Objects with metadata" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
							<ListBox ItemsSource="{Binding MetadataEditor.TargetsWithMetadata}" SelectedItem="{Binding MetadataEditor.SelectedTargetWithMetadata, Mode=TwoWay}" MaxHeight="150">
								<ListBox.ItemTemplate>
									<DataTemplate x:DataType="vm:ObjectMetadataTargetViewModel">
										<StackPanel Spacing="3" Margin="0,3">
											<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
											<ItemsControl ItemsSource="{Binding SummaryValues}">
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="vm:ObjectMetadataSummaryViewModel">
														<TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource ThemeSecondaryText}" TextWrapping="Wrap" />
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<TextBlock Text="No objects have metadata yet." IsVisible="{Binding MetadataEditor.HasNoMetadataTargets}" Foreground="{DynamicResource ThemeSecondaryText}" />
							<TextBlock Text="All objects" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
							<ComboBox ItemsSource="{Binding MetadataEditor.Targets}" SelectedItem="{Binding MetadataEditor.SelectedTarget, Mode=TwoWay}">
								<ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
							</ComboBox>
							<ItemsControl ItemsSource="{Binding MetadataEditor.Values}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:ObjectMetadataValueEditorViewModel">
										<Grid ColumnDefinitions="140,*" ColumnSpacing="10" Margin="0,4">
											<TextBlock Text="{Binding Field.Name}" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" />
											<ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Mode=TwoWay}" IsVisible="{Binding IsChoices}" />
											<ComboBox Grid.Column="1" ItemsSource="{Binding BooleanChoices}" SelectedItem="{Binding Value, Mode=TwoWay}" IsVisible="{Binding IsYesNo}" />
											<TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Watermark="{Binding Field.Type}" IsVisible="{Binding IsText}" AcceptsReturn="{Binding IsNotes}" />
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
					<TextBlock Text="No objects of this type are available for metadata." Foreground="{DynamicResource ThemeSecondaryText}" IsVisible="{Binding MetadataEditor.HasNoTargets}" />
				</StackPanel>
			</ScrollViewer>
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsSettingsListVisible}">
				<StackPanel Spacing="12">
					<Border IsVisible="{Binding IsApplicationSelected}" Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
						<StackPanel Spacing="8">
							<TextBlock Text="LaunchPad hotkey" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
							<TextBlock Text="Activate LaunchPad with this key chord. At least one modifier is required." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
							<TextBlock Text="X11 sessions use a global keyboard hook for activation." IsVisible="{Binding IsLinuxX11Session}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
							<TextBlock Text="Wayland sessions use the desktop Global Shortcuts portal. Launch from the applications menu so the portal can identify LaunchPad; your desktop may ask you to approve the shortcut. On GNOME, saving a new chord clears LaunchPad's previous saved portal assignment first." IsVisible="{Binding IsLinuxWaylandSession}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
							<TextBlock Text="Linux global activation needs an X11 session or a supported Wayland Global Shortcuts portal." IsVisible="{Binding IsLinuxSessionTypeUnknown}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" />
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="{Binding GlobalActivationHotkeyDisplay}" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" />
								<TextBlock Text="{Binding PendingGlobalActivationHotkeyDisplay}" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" IsVisible="{Binding HasPendingGlobalActivationHotkey}" />
								<Button Content="Change hotkey" Click="ChangeHotkey_Click" />
								<Button Content="Save shortcut" Click="SaveHotkey_Click" IsVisible="{Binding HasPendingGlobalActivationHotkey}" IsEnabled="{Binding CanSaveGlobalActivationHotkey}" />
							</StackPanel>
							<TextBlock Text="{Binding GlobalActivationHotkeyStatus}" Foreground="{DynamicResource ThemeSecondaryText}" TextWrapping="Wrap" />
						</StackPanel>
					</Border>
				<ItemsControl ItemsSource="{Binding Settings}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Background="{DynamicResource ThemePanelBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
								<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
									<TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" />
									<TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeSecondaryText}" Margin="0,5,0,10" />
									<ComboBox Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding Options}"
										  SelectedItem="{Binding Value, Mode=TwoWay}" IsVisible="{Binding IsSelect}" />
									<TextBox Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Value, Mode=TwoWay}" Watermark="{Binding Label}"
									 IsVisible="{Binding IsNotSelect}" />
									<TextBlock Grid.Row="3" Text="{Binding Token}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource ThemeAccent}" Margin="0,8,0,0" />
									<Button Grid.Row="3" Grid.Column="1" Content="Save" Command="{Binding SaveSettingCommand}" Margin="10,5,0,0" />
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</Window>

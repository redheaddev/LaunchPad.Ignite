<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaunchPad.Ignite.Core\LaunchPad.Ignite.Core.csproj" />
    <ProjectReference Include="..\LaunchPad.Ignite.App\LaunchPad.Ignite.App.csproj" />
    <ProjectReference Include="..\LaunchPad.Ignite.Extensions.Weather\LaunchPad.Ignite.Extensions.Weather.csproj" />
    <ProjectReference Include="..\LaunchPad.Ignite.Extensions.Ado\LaunchPad.Ignite.Extensions.Ado.csproj" />
    <ProjectReference Include="..\LaunchPad.Ignite.Extensions.Media\LaunchPad.Ignite.Extensions.Media.csproj" />
    <ProjectReference Include="..\LaunchPad.Ignite.Extensions.VsCode\LaunchPad.Ignite.Extensions.VsCode.csproj" />
  </ItemGroup>

  <Target Name="CopyVsCodeExtensionAssetsForTests" AfterTargets="Build">
    <ItemGroup>
      <VsCodeExtensionAsset Include="..\LaunchPad.Ignite.Extensions.VsCode\bin\$(Configuration)\net8.0\extensions\vscode\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)extensions\vscode" />
    <Copy SourceFiles="@(VsCodeExtensionAsset)"
          DestinationFiles="@(VsCodeExtensionAsset->'$(OutputPath)extensions\vscode\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
